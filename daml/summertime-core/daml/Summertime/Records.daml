-- | Outcome, receipt and progress records (specification F-6, F-11, section 13.2).
module Summertime.Records where

import DA.Optional (optionalToList)
import DA.Text qualified as T

import Summertime.Types

-- | How a campaign ended. Co-signed, so the forwarder cannot fabricate an outcome.
template CampaignOutcome with
    forwarder : Party
    operator : Party
    auditor : Optional Party
    campaignId : Text
    result : Outcome
    settledMilliCbm : Int
    settledMicroUsdc : Int
    legCount : Int
  where
    signatory forwarder, operator
    observer optionalToList auditor

-- | A private record for one importer. Convenience only: the authoritative evidence is the
-- update ID, which the importer can look up in its own ledger view.
template Receipt with
    forwarder : Party
    importer : Party
    campaignId : Text
    reservationId : Text
    kind : ReceiptKind
    reservedMilliCbm : Int
    amountMicroUsdc : Int
    note : Text
  where
    signatory forwarder
    observer importer

    -- | Confirm the physical booking for a settled importer (F-10). Tied to the Settled
    -- receipt, so a booking always refers to a real settlement.
    nonconsuming choice Receipt_ConfirmBooking : ContractId BookingConfirmation
      with
        bookingRef : Text
        etd : Date
        containerNo : Optional Text
      controller forwarder
      do
        require "a booking follows a settlement" (kind == Settled)
        require "booking reference is given" (bookingRef /= "")
        create BookingConfirmation with
          forwarder; importer; campaignId; reservationId; bookingRef; etd; containerNo
          acknowledgedAt = None

    -- | Open a dispute about a settled shipment (F-10). The evidence stays off-ledger; only
    -- its SHA-256 hash is recorded, so the record proves what was submitted without
    -- putting documents on the ledger.
    nonconsuming choice Receipt_OpenDispute : ContractId DisputeRecord
      with
        subject : Text
        evidenceHash : Text
      controller importer
      do
        require "disputes concern settled shipments" (kind == Settled)
        require "subject is given" (subject /= "")
        require "evidence hash is a SHA-256 hex digest" (T.length evidenceHash == 64)
        now <- getTime
        create DisputeRecord with
          importer; forwarder; campaignId; reservationId; subject; evidenceHash
          openedAt = now

-- | The forwarder's booking for one importer's space. Visible only to that importer.
template BookingConfirmation with
    forwarder : Party
    importer : Party
    campaignId : Text
    reservationId : Text
    bookingRef : Text
    etd : Date
    containerNo : Optional Text
    acknowledgedAt : Optional Time
  where
    signatory forwarder
    observer importer

    -- | The importer confirms it has seen the booking. Recorded on the contract (the
    -- specification listed this as non-consuming; recreating it keeps the acknowledgement
    -- in the active contract set).
    choice BookingConfirmation_Acknowledge : ContractId BookingConfirmation
      controller importer
      do
        require "booking not yet acknowledged" (acknowledgedAt == None)
        now <- getTime
        create this with acknowledgedAt = Some now

    -- | Amend ETD or container number (for example after a roll-over); clears the
    -- acknowledgement so the importer confirms again.
    choice BookingConfirmation_Amend : ContractId BookingConfirmation
      with
        newEtd : Date
        newContainerNo : Optional Text
      controller forwarder
      do
        create this with etd = newEtd; containerNo = newContainerNo; acknowledgedAt = None

-- | An open dispute between one importer and its forwarder. Never visible to other importers.
template DisputeRecord with
    importer : Party
    forwarder : Party
    campaignId : Text
    reservationId : Text
    subject : Text
    evidenceHash : Text
    openedAt : Time
  where
    signatory importer
    observer forwarder

    -- | The forwarder records its resolution, which both parties then hold. Refunds after
    -- success remain off-ledger in the MVP (F-10).
    choice DisputeRecord_Resolve : ContractId DisputeResolution
      with
        resolution : Text
      controller forwarder
      do
        require "resolution is given" (resolution /= "")
        now <- getTime
        create DisputeResolution with
          importer; forwarder; campaignId; reservationId; subject; evidenceHash; openedAt
          resolution
          resolvedAt = now

    -- | The importer withdraws its own dispute.
    choice DisputeRecord_Withdraw : ()
      controller importer
      do pure ()

-- | A resolved dispute, signed by both sides: the importer opened it, the forwarder resolved it.
template DisputeResolution with
    importer : Party
    forwarder : Party
    campaignId : Text
    reservationId : Text
    subject : Text
    evidenceHash : Text
    openedAt : Time
    resolution : Text
    resolvedAt : Time
  where
    signatory importer, forwarder

-- | Aggregate progress for exactly one importer (privacy rule P-4).
--
-- One contract per importer, so no importer sees another's identity in an observer list.
-- Published on a fixed schedule, rounded down to whole CBM, and hidden below three
-- committed importers.
template ProgressView with
    forwarder : Party
    importer : Party
    campaignId : Text
    reservedCbmRounded : Int
    participantCount : Optional Int
    hidden : Bool
    asOf : Time
  where
    signatory forwarder
    observer importer
    ensure
      reservedCbmRounded >= 0
      && (not hidden || (reservedCbmRounded == 0 && participantCount == None))

    choice ProgressView_Supersede : ContractId ProgressView
      with
        snapshot : ProgressSnapshot
      controller forwarder
      do
        require "progress moves forward in time" (snapshot.asOf > asOf)
        create this with
          reservedCbmRounded = snapshot.reservedCbmRounded
          participantCount = snapshot.participantCount
          hidden = snapshot.hidden
          asOf = snapshot.asOf

-- | One scheduled progress reading, as shown to every invited importer.
data ProgressSnapshot = ProgressSnapshot with
    reservedCbmRounded : Int
    participantCount : Optional Int
    hidden : Bool
    asOf : Time
  deriving (Eq, Show)

-- | Minimum committed importers before progress is shown (F-6).
progressMinimumParticipants : Int
progressMinimumParticipants = 3

-- | Build the reading every importer sees from the forwarder's own totals.
-- Rounds committed capacity down to whole CBM and hides it below three participants.
progressSnapshot : Time -> Bool -> Int -> Int -> ProgressSnapshot
progressSnapshot asOf showCount committedMilliCbm committedCount
  | committedCount < progressMinimumParticipants =
      ProgressSnapshot with reservedCbmRounded = 0; participantCount = None; hidden = True; asOf
  | otherwise =
      ProgressSnapshot with
        reservedCbmRounded = committedMilliCbm / 1000
        participantCount = if showCount then Some committedCount else None
        hidden = False
        asOf
